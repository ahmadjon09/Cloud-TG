# ─────────────────────────────────────────────────────────────
#  Cloud-TG — environment variables
#  Copy to .env and fill in. Never commit .env
# ─────────────────────────────────────────────────────────────

# Telegram bot (from @BotFather)
BOT_TOKEN=123456:ABC-DEF...
BOT_USERNAME=your_cloud_bot

# Public HTTPS URL of this server (required for the WebApp button & keep-alive)
BASE_URL=https://your-domain.com

# Database
MONGO_URI=mongodb://127.0.0.1:27017/cloudtg

# Comma separated Telegram user IDs with admin access
ADMIN_IDS=123456789,987654321

# HTTP
PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# Optional: second bot used for user support tickets
# BOT_TOKEN_SUP=

# ── Demo / local UI development ──────────────────────────────
# DEMO_MODE=true  → runs with the in-memory store (NO data is persisted)
#                   and lets you open /app in a normal browser without Telegram.
# NEVER enable this on a production server.
# DEMO_MODE=true
# DEMO_USER_ID=100000001

# initData lifetime (seconds) — Telegram's default is 24h
# INIT_DATA_TTL=86400

# Signed Cloud browser-session lifetime (seconds). It renews from valid initData
# and keeps an already-open Mini App working after Telegram's 24h payload expires.
# WEB_SESSION_TTL=604800

# Extra hosts allowed to embed the app in an iframe (comma separated)
# ALLOWED_FRAME_HOSTS=https://web.telegram.org,https://t.me

# Set to true to disable the self-ping keep-alive
# DISABLE_PING=false
